<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root type="StackPane"
         xmlns="http://javafx.com/javafx/26"
         xmlns:fx="http://javafx.com/fxml/1"
         style="-fx-background-color: rgba(255,255,255,0.1);
                -fx-background-radius: 10;">

    <VBox spacing="10">

        <padding>
            <Insets bottom="15" left="15" right="15" top="15"/>
        </padding>

        <HBox alignment="CENTER" fillHeight="false">

            <Label fx:id="lblSectionTitle"
                   text="Playlists"
                   textFill="WHITE">
                <font>
                    <Font name="SF Pro Display Bold" size="20"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblItemsInSection"
                   text="30"
                   textFill="WHITE"
                   style="-fx-opacity: 0.4;">
                <font>
                    <Font name="SF Pro Display Regular" size="10"/>
                </font>
            </Label>

        </HBox>

        <ListView fx:id="lstSection"
                  prefWidth="155"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;"/>

    </VBox>

    <Button fx:id="btnAdd" onMouseClicked="#btnAddClicked"
            alignment="CENTER"
            mnemonicParsing="false"
            managed="${btnAdd.visible}"
            style="-fx-background-color: white;
                   -fx-background-radius: 50;"
            text="Create"
            StackPane.alignment="BOTTOM_RIGHT">

        <font>
            <Font name="SF Pro Display Bold" size="15"/>
        </font>

        <StackPane.margin>
            <Insets bottom="15" right="15"/>
        </StackPane.margin>

    </Button>

</fx:root>