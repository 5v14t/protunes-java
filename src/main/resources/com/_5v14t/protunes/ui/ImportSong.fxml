<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="421.0" prefWidth="609.0" spacing="30.0" style="-fx-background-color: #121217;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com._5v14t.protunes.ui.ImportSongController">
   <children>
      <HBox alignment="CENTER" spacing="18.0" VBox.vgrow="NEVER">
         <children>
            <Label text="Title" textFill="WHITE">
               <font>
                  <Font name="SF Pro Display Regular" size="29.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="lblTitle" maxHeight="1.7976931348623157E308" style="-fx-background-color: #343442;">
               <font>
                  <Font name="SF Pro Display Regular" size="16.0" />
               </font>
            </TextField>
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutX="10.0" layoutY="10.0" spacing="18.0" VBox.vgrow="NEVER">
         <children>
            <Label alignment="TOP_LEFT" text="Artist" textFill="WHITE">
               <font>
                  <Font name="SF Pro Display Regular" size="29.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="lblArtist" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: #343442;">
               <font>
                  <Font name="SF Pro Display Regular" size="16.0" />
               </font>
            </TextField>
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutX="10.0" layoutY="110.0" spacing="18.0" VBox.vgrow="NEVER">
         <children>
            <Label text="Genre" textFill="WHITE">
               <font>
                  <Font name="SF Pro Display Regular" size="29.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="lblGenre" maxHeight="1.7976931348623157E308" style="-fx-background-color: #343442;">
               <font>
                  <Font name="SF Pro Display Regular" size="16.0" />
               </font>
            </TextField>
         </children>
      </HBox>
      <Button fx:id="btnSave" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #7B7B98;" text="Save" textFill="#f8f8f8" VBox.vgrow="NEVER" />
   </children>
   <padding>
      <Insets bottom="100.0" left="100.0" right="100.0" top="100.0" />
   </padding>
</VBox>
